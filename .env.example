# Copy to .env
DATABASE_URL=postgres://tallybird:tallybird@127.0.0.1:5432/tallybird
PORT=3000
SESSION_SECRET=change-me-in-production
# Optional. Without a key, payments go to the built-in test gateway.
STRIPE_SECRET_KEY=
# Vercel sends it with each scheduled call (vercel.json); set the same value to call /api/cron/* yourself.
CRON_SECRET=
# Optional. With a QStash token, emails go through Upstash QStash, which calls APP_URL back, signed; without one they go out at once.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# QSTASH_URL=https://qstash.upstash.io
# APP_URL=https://tallybird.example.com
